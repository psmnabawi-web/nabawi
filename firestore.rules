rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return hasProfile() ? profile().role : 'none'; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isManager() { return signedIn() && (role() == 'manager' || role() == 'admin'); }
    function myStore() { return hasProfile() ? profile().storeId : null; }
    function canSeeStore(storeId) { return isAdmin() || (signedIn() && myStore() == storeId); }

    // Semua penulisan dilakukan lewat API server (Firebase Admin SDK). Client hanya membaca.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow write: if false;
    }
    match /stores/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /indicators/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /audits/{auditId} {
      allow read: if signedIn() && canSeeStore(resource.data.storeId);
      allow write: if false;
      match /items/{itemId} {
        allow read: if signedIn() && canSeeStore(get(/databases/$(database)/documents/audits/$(auditId)).data.storeId);
        allow write: if false;
      }
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
