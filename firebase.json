{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": {
    "backendId": "store-cleanliness",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env",
      ".env.*",
      "*.log",
      "scratchpad"
    ],
    "alwaysDeployFromSource": true
  }
}
