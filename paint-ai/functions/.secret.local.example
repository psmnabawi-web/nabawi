# Local emulator secrets only. Copy to functions/.secret.local (git-ignored).
# In production use: firebase functions:secrets:set <NAME>
# Unused providers: leave the value as "disabled".
GEMINI_API_KEY=disabled
OPENAI_API_KEY=disabled
ANTHROPIC_API_KEY=disabled
RUNWAY_API_KEY=disabled
# Kling: either an API key in KLING_ACCESS_KEY (leave KLING_SECRET_KEY=disabled),
# or an access key + secret key pair (JWT auth).
KLING_ACCESS_KEY=disabled
KLING_SECRET_KEY=disabled
# Pika is served through fal.ai → FAL_KEY
FAL_KEY=disabled
HEYGEN_API_KEY=disabled
