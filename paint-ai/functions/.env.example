# ============================================================
# Cloud Functions runtime config (non-secret).
# Copy to functions/.env  →  Firebase CLI loads it on deploy & in the emulator.
# API keys are NOT stored here: use Secret Manager (see README "Secrets").
# ============================================================

# Region. Must match (or be compatible with) your Firestore location.
# asia-southeast2 = Jakarta.
FUNCTIONS_REGION=asia-southeast2

# Emails that automatically become SUPER ADMIN on first login (comma separated).
# The email must be verified (Google sign-in, or email/password after verification link).
SUPER_ADMIN_EMAILS=

# ---------- Text AI ----------
# Default provider: gemini | openai | claude | mock   (can be overridden in Settings > AI & Integrations)
AI_PROVIDER=gemini
# Gemini: gemini-3.8-flash (newest GA) | gemini-3.6-flash | gemini-flash-latest
GEMINI_MODEL=gemini-3.8-flash
# Automatic fallback when the primary model is overloaded (503), rate limited or not found
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# OpenAI: gpt-6-sol (flagship) | gpt-6-luna (cheaper) | gpt-5.5
OPENAI_MODEL=gpt-6-sol
# Claude: claude-opus-5 (default) | claude-sonnet-5 | claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5

# Gemini via Vertex AI (uses the Functions service account, no API key). Leave false to use GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_LOCATION=global

# ---------- Video AI ----------
# Default provider: veo | runway | kling | pika | heygen | mock
VIDEO_PROVIDER=veo
# Google Veo on Vertex AI: no API key — uses the Functions service account and bills the Firebase project
# (Google Cloud free-trial credits apply). Needs the Vertex AI API (aiplatform.googleapis.com) enabled.
# veo-3.1-lite-generate-001 (cheapest) | veo-3.1-fast-generate-001 | veo-3.1-generate-001
VEO_ENABLED=true
VEO_MODEL=veo-3.1-lite-generate-001
VEO_LOCATION=us-central1
# 720p (4/6/8s clips) | 1080p (8s clips only, pricier)
VEO_RESOLUTION=720p
# Native audio costs more per second; the stitched video gets silence when false.
VEO_GENERATE_AUDIO=false
# Runway text_to_video: gen4.5 (2-10s clips) | veo3.1 | veo3.1_fast (4/6/8s clips)
RUNWAY_MODEL=gen4.5
# Kling: kling-v2-5-turbo | kling-v2-6 | kling-v3   ·  mode: std | pro
KLING_MODEL=kling-v2-5-turbo
KLING_MODE=pro
KLING_API_BASE=https://api-singapore.klingai.com
PIKA_FAL_ENDPOINT=fal-ai/pika/v2.2/text-to-video
# HeyGen (API v3): default avatar & voice (can be changed in Settings)
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ---------- Social posting (Instagram Reels) ----------
# Meta app > Instagram > API setup with Instagram login: "Instagram app ID" (the secret goes to Secret
# Manager as INSTAGRAM_APP_SECRET). Redirect URI to register: https://<PROJECT_ID>.web.app/api/oauth/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_GRAPH_VERSION=v24.0
# Only when the site is served from a custom domain:
# PUBLIC_BASE_URL=https://content.example.com

# ---------- Guard rails ----------
# Max AI text generations per user per day, and max video jobs per user per day.
AI_DAILY_LIMIT=200
VIDEO_DAILY_LIMIT=20
# A video stuck in Processing longer than this is marked Failed.
VIDEO_TIMEOUT_MINUTES=60
