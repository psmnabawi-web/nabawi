# ===== Firebase Web SDK (Project Settings > General > Your apps) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (server) =====
# Isi salah satu:
# a) JSON service account satu baris (Project Settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=
# b) atau path file: GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# c) atau kosongkan keduanya saat deploy di Firebase App Hosting (pakai default credential)

# ===== Anthropic (analisa foto) =====
ANTHROPIC_API_KEY=
# Model vision. Default claude-opus-5. Alternatif hemat biaya: claude-sonnet-5
AI_MODEL=claude-opus-5

# ===== Bootstrap admin =====
# Email yang otomatis mendapat role admin saat pertama login (pisahkan dengan koma)
ADMIN_EMAILS=psmnabawi@gmail.com
