# ===== Firebase Web SDK (Firebase Console > Project Settings > General > Your apps > Web) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (server) =====
# Lokal: isi JSON service account satu baris (Project Settings > Service accounts > Generate new private key).
# Di Firebase App Hosting / Cloud Run: kosongkan, otomatis pakai default credential.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===== AI =====
# google (default) = Gemini. anthropic = Claude.
AI_PROVIDER=google

# --- Opsi A (GRATIS, disarankan untuk mulai): Gemini API key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# --- Opsi B (berbayar, kuota produksi): Vertex AI. Set true, pastikan API "aiplatform.googleapis.com" aktif & billing on.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=PROJECT_ID
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Opsi C: Claude
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Model. Google: gemini-3.6-flash (default) | gemini-3.5-flash-lite (lebih murah/cepat) | gemini-flash-latest (alias terbaru). Anthropic: claude-opus-5 | claude-sonnet-5
AI_MODEL=gemini-3.6-flash

# ===== Bootstrap admin =====
# Email yang otomatis mendapat role admin saat pertama login (pisahkan dengan koma)
ADMIN_EMAILS=psmnabawi@gmail.com
